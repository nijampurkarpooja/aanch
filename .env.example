# Copy to .env.local for local development. Placeholders only: never commit real values.

# Hosts the app answers on (host[:port]). The proxy routes requests by these.
STORE_HOST=localhost:3000
ADMIN_HOST=admin.localhost:3000

# Spike R4: a Neon Object Storage credential on the dev branch (storage:read and storage:write).
STORAGE_ENDPOINT=https://br-example.storage.c-0.ap-southeast-1.aws.neon.tech
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=aanch-spike
STORAGE_ACCESS_KEY_ID=placeholder
STORAGE_SECRET_ACCESS_KEY=placeholder
