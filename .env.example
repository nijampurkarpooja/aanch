# Copy to .env.local for local development. Placeholders only: never commit real values.

# Hosts the app answers on (host[:port]). The proxy routes requests by these.
STORE_HOST=localhost:3000
ADMIN_HOST=admin.localhost:3000

# Razorpay test mode: the secret set on the webhook in the Razorpay Dashboard (not the API key),
# at least 32 characters. Empty means webhooks answer 503.
RAZORPAY_WEBHOOK_SECRET=
